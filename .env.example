# speaking-buddy 环境变量
#
# 用法：复制成 .env 再填真实值。
#   cp .env.example .env
#
# `pnpm dev` / `pnpm start` 通过 `tsx --env-file=.env` 只读本目录的 .env。
# 旁边仓库（例如 ../super-agent/.env）里的同名变量不会自动生效。
# .env 已在 .gitignore 里，不要把填好的文件提交进仓库。

# ────────────────────────────────────────────────────────────
# 飞书自建应用（启动必填）
# ────────────────────────────────────────────────────────────
# 缺任何一个，进程启动即报「缺少 FEISHU_APP_ID / FEISHU_APP_SECRET」。
#
# 去哪里拿：
#   1. 打开飞书开放平台 https://open.feishu.cn/app 并登录
#   2. 进入已有的「企业自建应用」，或新建一个
#   3. 左侧「凭证与基础信息」
#   4. App ID  → FEISHU_APP_ID（以 cli_ 开头）
#   5. App Secret → FEISHU_APP_SECRET（页面上点查看；重置后旧值立刻失效）
#
# 本机若已有可用的同一个 bot，也可以从 ../super-agent/.env 抄这两行。
# 新建应用和复用旧应用都可以，但权限、事件订阅、机器人能力必须配在
# 「你填进这里的这一个应用」上，配在别的应用上无效。
#
# 这个应用至少要有：
#   - 能力：机器人
#   - 权限：im:message、im:message:send_as_bot、im:resource、
#           im:chat、im:message.reaction:write
#   - 事件：im.message.receive_v1，接收方式选「使用长连接接收事件」
#   - 发布：创建版本并发布到本企业，否则自己也收不到消息
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=

# ────────────────────────────────────────────────────────────
# 对话模型（默认必填 Moonshot）
# ────────────────────────────────────────────────────────────
# LLM_PROVIDER 决定用哪一家。不填等于 moonshot。
# 可选值：moonshot | gemini
# moonshot 是唯一实测能进 1.5s 的；gemini 仅在你显式改成 gemini 时才会用。
LLM_PROVIDER=moonshot

# Moonshot / Kimi。控制台：https://platform.moonshot.cn/console/api-keys
# 不填 MOONSHOT_MODEL 时，代码默认 kimi-k2.7-code-highspeed。
# 不要改成 kimi-k3 / k2.6：那两个是推理模型，一句话要 12–19 秒。
MOONSHOT_API_KEY=
MOONSHOT_MODEL=kimi-k2.7-code-highspeed

# ────────────────────────────────────────────────────────────
# Gemini 中转（可选，LLM_PROVIDER=gemini 时才必填）
# ────────────────────────────────────────────────────────────
# 只在把上面的 LLM_PROVIDER 改成 gemini 之后才会读取。
# 不填 FLASHWAY_BASE_URL 时，代码默认 https://gw.flashway.ai/v1。
# 不填 GEMINI_MODEL 时，代码默认 gemini-3.8-flash-low。
FLASHWAY_BASE_URL=https://gw.flashway.ai/v1
FLASHWAY_API_KEY=
GEMINI_MODEL=gemini-3.8-flash-low

# ────────────────────────────────────────────────────────────
# 语音合成（启动后发语音必填）
# ────────────────────────────────────────────────────────────
# Edge TTS 在本机已经连不上（2026-10-25：新地址回空 HTTP 200，旧地址连接被重置）。
# 现在用 MiniMax 同步语音合成，失败就发不出去语音。
#
# 去哪里拿：
#   1. 打开 https://platform.minimax.cn/ 并登录
#   2. 账户管理 → 接口密钥 → 创建按量付费的 API Key
#   3. 账户里要有余额，否则接口会拒
#
# 不填 MINIMAX_TTS_BASE_URL 时，代码默认 https://api.minimax.cn。
# 人在华北、首包偏慢时，可以改成 https://api-bj.minimaxi.com。
# 不填 MINIMAX_TTS_MODEL 时，代码默认 speech-2.8-hd（比 turbo 更有语气）。
# 不填 MINIMAX_VOICE 时，代码默认 English_Gentle-voiced_man（通用美式口音）。
# 场景 config/scenario.json 里的 voice 会盖过这个默认值。
# 需要放慢时，在场景里写 ttsRate，例如 "-10%"，代码会换成 speed 0.9。
# 不写 ttsRate 就是原速 1.0。
MINIMAX_API_KEY=
MINIMAX_TTS_BASE_URL=https://api.minimax.cn
MINIMAX_TTS_MODEL=speech-2.8-hd
MINIMAX_VOICE=English_Gentle-voiced_man

# ────────────────────────────────────────────────────────────
# 本地 ASR 模型下载（可选）
# ────────────────────────────────────────────────────────────
# faster-whisper 第一次加载 small.en 时要从 Hugging Face 拉约 480MB。
# 不填时代码默认 https://hf-mirror.com（本机直连 huggingface.co 不稳定）。
# 模型下完之后，这个变量不再影响识别速度。
HF_ENDPOINT=https://hf-mirror.com
