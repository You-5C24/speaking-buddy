{
  "name": "speaking-buddy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "probe:llm": "tsx --env-file=.env src/probe-llm.ts",
    "typecheck": "tsc --noEmit",
    "check:blocks": "tsx scripts/check-blocks.ts",
    "check:scenarios": "tsx scripts/check-scenarios.ts",
    "check": "tsx scripts/check-blocks.ts && tsx scripts/check-scenarios.ts && tsx scripts/check-runtime.ts",
    "check:runtime": "tsx scripts/check-runtime.ts",
    "probe:gen": "tsx --env-file=.env src/probe-scenario-gen.ts"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "dotenv": "^17.4.2",
    "ffprobe-static": "^3.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
